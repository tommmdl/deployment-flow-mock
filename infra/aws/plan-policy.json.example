{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":["ec2:DescribeVpcs","ec2:DescribeSubnets","ec2:DescribeInternetGateways","ec2:DescribeAddresses","ec2:DescribeNatGateways","ec2:DescribeRouteTables","ec2:DescribeLaunchTemplates","ec2:DescribeLaunchTemplateVersions","ec2:DescribeTags"],"Resource":"*"},
    {"Effect":"Allow","Action":["eks:DescribeCluster","eks:DescribeNodegroup","eks:ListTagsForResource"],"Resource":["arn:aws:eks:us-east-1:ACCOUNT_ID:cluster/deployment-flow","arn:aws:eks:us-east-1:ACCOUNT_ID:nodegroup/deployment-flow/*/*"]},
    {"Effect":"Allow","Action":["iam:GetRole","iam:ListAttachedRolePolicies","iam:ListRolePolicies"],"Resource":"arn:aws:iam::ACCOUNT_ID:role/deployment-flow-*"},
    {"Effect":"Allow","Action":["logs:DescribeLogGroups"],"Resource":"*"},
    {"Effect":"Allow","Action":["logs:ListTagsForResource"],"Resource":"arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/eks/deployment-flow/cluster"},
    {"Effect":"Allow","Action":["budgets:ViewBudget"],"Resource":"arn:aws:budgets::ACCOUNT_ID:budget/deployment-flow"},
    {"Effect":"Allow","Action":["s3:ListBucket"],"Resource":"arn:aws:s3:::STATE_BUCKET","Condition":{"StringLike":{"s3:prefix":["deployment-flow/*"]}}},
    {"Effect":"Allow","Action":["s3:GetObject"],"Resource":"arn:aws:s3:::STATE_BUCKET/deployment-flow/production.tfstate"},
    {"Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:DeleteObject"],"Resource":"arn:aws:s3:::STATE_BUCKET/deployment-flow/production.tfstate.tflock"}
  ]
}
